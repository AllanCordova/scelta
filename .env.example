# PostgreSQL
DATABASE_URL=postgresql://scelta:scelta@localhost:5433/scelta

# API
API_HOST=0.0.0.0
API_PORT=3333
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# First admin, created on startup when this email is not registered yet.
# Production rejects this password. Voting pages do not use this account.
ADMIN_EMAIL=admin@igreja.local
ADMIN_PASSWORD=dev-admin-password
ADMIN_NAME=Administrador
CHURCH_NAME=Igreja local

# Set to pglite to run the API without PostgreSQL. Leave unset when DATABASE_URL is used.
# SCELTA_DB=pglite

# Web. Leave empty so the browser calls /v1 on the same origin.
VITE_API_URL=
