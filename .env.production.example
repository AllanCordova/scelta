# Public URL & Host bind
PUBLIC_URL=https://scelta.seu-dominio.com.br
HTTP_BIND=127.0.0.1:8080

# PostgreSQL (Internal network only - use URL-safe characters without # or @)
POSTGRES_USER=scelta
POSTGRES_PASSWORD=troque-por-uma-senha-forte-do-banco
POSTGRES_DB=scelta

# Bootstrap / Operator Admin Account (minimum 12 characters required in production)
ADMIN_EMAIL=admin@igreja.local
ADMIN_PASSWORD=troque-por-uma-senha-forte-de-12-caracteres
ADMIN_NAME=Administrador
CHURCH_NAME=Igreja Presbiteriana

# Cloudflare Tunnel Token (used with `--profile share`)
# Configure the Public Hostname in Cloudflare Zero Trust to point to: http://web:80
CLOUDFLARE_TUNNEL_TOKEN=
